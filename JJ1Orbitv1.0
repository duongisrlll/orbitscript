    Suffix = " studs",
    CurrentValue = Config.Height,
    Flag = "OrbitHeight",
    Callback = function(v) Config.Height = v end,
})

OrbitTab:CreateSlider({
    Name = "Speed",
    Range = { 0.1, 30 },
    Increment = 0.1,
    Suffix = " v/s",
    CurrentValue = Config.Speed,
    Flag = "OrbitSpeed",
    Callback = function(v) Config.Speed = v end,
})

OrbitTab:CreateSlider({
    Name = "Orbit Movement Speed",
    Range = { 1, 100 },
    Increment = 1,
    CurrentValue = Config.OrbitSpeed,
    Flag = "OrbitMovementSpeed",
    Callback = function(v) Config.OrbitSpeed = v end,
})

OrbitTab:CreateToggle({
    Name = "Unlimited Speed",
    CurrentValue = false,
    Flag = "UnlimitedSpeed",
