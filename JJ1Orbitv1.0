})

OrbitTab:CreateSlider({
    Name = "Smoothness",
    Range = { 0, 0.95 },
    Increment = 0.05,
    CurrentValue = Config.Smoothness,
    Flag = "OrbitSmooth",
    Callback = function(v) Config.Smoothness = v end,
})

local targetOptions = {}
local targetMap = {}
local function refreshTargetDropdown()
    targetOptions = {}
    targetMap = {}
    for _, t in ipairs(getAllTargets()) do
        table.insert(targetOptions, t.Name)
        targetMap[t.Name] = t.Model
    end
    if #targetOptions == 0 then targetOptions = { "No targets" } end
end

local targetDropdown
targetDropdown = OrbitTab:CreateDropdown({
    Name = "Select Player/NPC to Orbit",
    Options = targetOptions,
    CurrentOption = {},
    Flag = "OrbitTargetDropdown",
    Callback = function(opt)
        local name = type(opt) == "table" and opt[1] or opt
        if name and targetMap[name] then
            Config.ManualTarget = targetMap[name]
            Config.TargetMode = "Manual"
        end
    end,
})

OrbitTab:CreateButton({
    Name = "Refresh Target List",
    Callback = function()
        refreshTargetDropdown()
        if targetDropdown and targetDropdown.Refresh then
            targetDropdown:Refresh(targetOptions)
        end
        Rayfield:Notify({ Title = "Orbit", Content = "Target list refreshed", Duration = 3 })
    end,
})

OrbitTab:CreateDropdown({
    Name = "Target Mode",
    Options = { "Closest", "Killer", "Manual" },
    CurrentOption = { Config.TargetMode },
    Flag = "OrbitTargetMode",
    Callback = function(opt)
        Config.TargetMode = type(opt) == "table" and opt[1] or opt
    end,
})

OrbitTab:CreateToggle({
    Name = "Lock Rotation (Look at target)",
    CurrentValue = true,
    Flag = "OrbitLockRot",
    Callback = function(v) Config.LockRotation = v end,
})

OrbitTab:CreateButton({
    Name = "Set Manual Target to Closest",
    Callback = function()
        local t = getClosestTarget()
        if t then
            Config.ManualTarget = t
            Config.TargetMode = "Manual"
            Rayfield:Notify({ Title = "Orbit", Content = "Target: " .. t.Name, Duration = 3 })
        else
            Rayfield:Notify({ Title = "Orbit", Content = "No target found", Duration = 3 })
        end
    end,
})

refreshTargetDropdown()
